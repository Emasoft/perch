node_modules/
dist/
.perch/*
!.perch/closed.jsonl
!.perch/rules/
.env

# A lock or a half-written rule file, left by a perch that died mid-edit.
perch.yaml.lock
perch.yaml.*.tmp

# Clones and runs made by the benchmark runners.
.benchmarks/*/runs/

# Benchmark data, downloaded from Hugging Face (see .benchmarks/*/README.md).
.benchmarks/hf/

# The janitor's per-session detector state, written under the project root and never part of the repository.
.janitor/

# Scratch and raw output (reports_dev/, scripts_dev/, ...) is private or intermediate and never committed.
# reports/ holds final reports and stays tracked.
*_dev/
